<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- =========================== USER ================================== -->

    <changeSet id="20260816-1" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_user"/>
            </not>
        </preConditions>

        <createTable tableName="im_user">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="google_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_user" columnNames="id" constraintName="pk_user"/>

        <addUniqueConstraint tableName="im_user" columnNames="email" constraintName="uk_3602435580614"/>

        <addUniqueConstraint tableName="im_user" columnNames="google_id" constraintName="uk_4471209836512"/>

        <createSequence sequenceName="im_user_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== INVENTORY ================================== -->

    <changeSet id="20260816-13" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_inventory"/>
            </not>
        </preConditions>

        <createTable tableName="im_inventory">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="id_user" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_inventory" columnNames="id" constraintName="pk_inventory"/>

        <addForeignKeyConstraint baseTableName="im_inventory" baseColumnNames="id_user"
                                 referencedTableName="im_user" referencedColumnNames="id"
                                 constraintName="fk_9553013621156"/>

        <createSequence sequenceName="im_inventory_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== ITEM ================================== -->

    <changeSet id="20260816-18" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_item"/>
            </not>
        </preConditions>

        <createTable tableName="im_item">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="price" type="BIGINT"/>
            <column name="locale" type="VARCHAR(255)"/>
            <column name="responsible" type="VARCHAR(255)"/>
            <column name="qr_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="is_valid" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="validated_at" type="TIMESTAMP"/>
            <column name="id_inventory" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_item" columnNames="id" constraintName="pk_item"/>

        <addForeignKeyConstraint baseTableName="im_item" baseColumnNames="id_inventory"
                                 referencedTableName="im_inventory" referencedColumnNames="id"
                                 constraintName="fk_4475173894937"/>

        <createSequence sequenceName="im_item_id" incrementBy="1" startValue="1"/>

    </changeSet>


    <!-- =========================== OBSERVATION ================================== -->

    <changeSet id="20260816-21" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_observation"/>
            </not>
        </preConditions>

        <createTable tableName="im_observation">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="id_item" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_observation" columnNames="id" constraintName="pk_observation"/>

        <addForeignKeyConstraint baseTableName="im_observation" baseColumnNames="id_item"
                                 referencedTableName="im_item" referencedColumnNames="id"
                                 constraintName="fk_9506536018245"/>

        <createIndex tableName="im_observation" indexName="ix_0031251303422">
            <column name="id_item"/>
        </createIndex>

        <createSequence sequenceName="im_observation_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== SECTOR ================================== -->

    <changeSet id="20260816-23" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_sector"/>
            </not>
        </preConditions>

        <createTable tableName="im_sector">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_sector" columnNames="id" constraintName="pk_sector"/>

        <addUniqueConstraint tableName="im_sector" columnNames="name" constraintName="uk_2309759590555"/>

        <createSequence sequenceName="im_sector_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== PROFILE ================================== -->

    <changeSet id="20260816-24" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_profile"/>
            </not>
        </preConditions>

        <createTable tableName="im_profile">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_profile" columnNames="id" constraintName="pk_profile"/>

        <addUniqueConstraint tableName="im_profile" columnNames="name" constraintName="uk_2881395176814"/>

        <createSequence sequenceName="im_profile_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== PERMISSION ================================== -->

    <changeSet id="20260816-25" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_permission"/>
            </not>
        </preConditions>

        <createTable tableName="im_permission">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
        </createTable>

        <addPrimaryKey tableName="im_permission" columnNames="id" constraintName="pk_permission"/>

        <addUniqueConstraint tableName="im_permission" columnNames="name" constraintName="uk_6834716892658"/>

        <createSequence sequenceName="im_permission_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== PROFILE_PERMISSION ================================== -->

    <changeSet id="20260816-26" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_profile_permission"/>
            </not>
        </preConditions>

        <createTable tableName="im_profile_permission">
            <column name="id_profile" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id_permission" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_profile_permission" columnNames="id_profile, id_permission"
                       constraintName="pk_profile_permission"/>

        <addForeignKeyConstraint baseTableName="im_profile_permission" baseColumnNames="id_profile"
                                 referencedTableName="im_profile" referencedColumnNames="id"
                                 constraintName="fk_6817783948865"/>

        <addForeignKeyConstraint baseTableName="im_profile_permission" baseColumnNames="id_permission"
                                 referencedTableName="im_permission" referencedColumnNames="id"
                                 constraintName="fk_7295054806827"/>

    </changeSet>

    <!-- =========================== SEED: PERMISSIONS ================================== -->

    <changeSet id="20260816-27" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM im_permission</sqlCheck>
        </preConditions>

        <insert tableName="im_permission">
            <column name="id" valueComputed="nextval('im_permission_id')"/>
            <column name="name" value="ADMIN"/>
            <column name="description" value="Administra setores, perfis, permissoes e usuarios."/>
        </insert>
        <insert tableName="im_permission">
            <column name="id" valueComputed="nextval('im_permission_id')"/>
            <column name="name" value="MANAGE_SECTOR"/>
            <column name="description" value="Gerencia inventarios e usuarios do proprio setor."/>
        </insert>
        <insert tableName="im_permission">
            <column name="id" valueComputed="nextval('im_permission_id')"/>
            <column name="name" value="MANAGE_ITEM"/>
            <column name="description" value="Gerencia itens do proprio setor."/>
        </insert>

    </changeSet>

    <!-- =========================== SEED: PROFILES ================================== -->

    <changeSet id="20260816-28" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM im_profile</sqlCheck>
        </preConditions>

        <insert tableName="im_profile">
            <column name="id" valueComputed="nextval('im_profile_id')"/>
            <column name="name" value="ADMIN_ORGANIZATION"/>
            <column name="description" value="Administra a organizacao inteira."/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="im_profile">
            <column name="id" valueComputed="nextval('im_profile_id')"/>
            <column name="name" value="GESTOR_SETOR"/>
            <column name="description" value="Gerencia inventarios, usuarios e pendencias do proprio setor."/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="im_profile">
            <column name="id" valueComputed="nextval('im_profile_id')"/>
            <column name="name" value="OPERADOR_CAMPO"/>
            <column name="description" value="Realiza levantamento em campo."/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
        <insert tableName="im_profile">
            <column name="id" valueComputed="nextval('im_profile_id')"/>
            <column name="name" value="CONSULTA"/>
            <column name="description" value="Apenas consulta informacoes."/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

    </changeSet>

    <!-- =========================== SEED: PROFILE_PERMISSION ================================== -->

    <changeSet id="20260816-29" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM im_profile_permission</sqlCheck>
        </preConditions>

        <sql>
            INSERT INTO im_profile_permission (id_profile, id_permission)
            SELECT p.id, perm.id FROM im_profile p, im_permission perm
            WHERE p.name = 'ADMIN_ORGANIZATION' AND perm.name = 'ADMIN';

            INSERT INTO im_profile_permission (id_profile, id_permission)
            SELECT p.id, perm.id FROM im_profile p, im_permission perm
            WHERE p.name = 'GESTOR_SETOR' AND perm.name = 'MANAGE_SECTOR';

            INSERT INTO im_profile_permission (id_profile, id_permission)
            SELECT p.id, perm.id FROM im_profile p, im_permission perm
            WHERE p.name = 'OPERADOR_CAMPO' AND perm.name = 'MANAGE_ITEM';

            <!-- CONSULTA nao recebe nenhuma permissao: o documento nao define uma permissao de somente leitura. -->
        </sql>

    </changeSet>

    <!-- =========================== USER SECTOR/PROFILE ================================== -->

    <changeSet id="20260816-30" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="im_user" columnName="id_sector"/>
            </not>
        </preConditions>

        <addColumn tableName="im_user">
            <column name="id_sector" type="BIGINT"/>
            <column name="id_profile" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="im_user" baseColumnNames="id_sector"
                                 referencedTableName="im_sector" referencedColumnNames="id"
                                 constraintName="fk_6424971323953"/>

        <addForeignKeyConstraint baseTableName="im_user" baseColumnNames="id_profile"
                                 referencedTableName="im_profile" referencedColumnNames="id"
                                 constraintName="fk_4905885375880"/>

    </changeSet>

    <!-- =========================== SECTOR ALLOCATION ================================== -->

    <changeSet id="20261003-1" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_sector_allocation"/>
            </not>
        </preConditions>

        <createTable tableName="im_sector_allocation">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="id_user" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="id_sector" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="im_sector_allocation" columnNames="id" constraintName="pk_sector_allocation"/>

        <addForeignKeyConstraint baseTableName="im_sector_allocation" baseColumnNames="id_user"
                                 referencedTableName="im_user" referencedColumnNames="id"
                                 constraintName="fk_sector_allocation_user"/>

        <addForeignKeyConstraint baseTableName="im_sector_allocation" baseColumnNames="id_sector"
                                 referencedTableName="im_sector" referencedColumnNames="id"
                                 constraintName="fk_sector_allocation_sector"/>

        <addUniqueConstraint tableName="im_sector_allocation" columnNames="id_user, id_sector"
                             constraintName="uk_sector_allocation_user_sector"/>

        <createSequence sequenceName="im_sector_allocation_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <changeSet id="20261003-2" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="im_user" columnName="id_sector"/>
        </preConditions>

        <sql>
            INSERT INTO im_sector_allocation (id, id_user, id_sector)
            SELECT nextval('im_sector_allocation_id'), id, id_sector
            FROM im_user
            WHERE id_sector IS NOT NULL;
        </sql>

    </changeSet>

    <changeSet id="20261003-3" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="im_user" columnName="id_sector"/>
        </preConditions>

        <dropForeignKeyConstraint baseTableName="im_user" constraintName="fk_6424971323953"/>

        <dropColumn tableName="im_user" columnName="id_sector"/>

    </changeSet>

</databaseChangeLog>
