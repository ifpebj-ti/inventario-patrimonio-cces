            </column>
        </createTable>

        <addPrimaryKey tableName="im_organization" columnNames="id" constraintName="pk_organization"/>

        <addUniqueConstraint tableName="im_organization" columnNames="name" constraintName="uk_6938349274896"/>

        <createSequence sequenceName="im_organization_id" incrementBy="1" startValue="1"/>

    </changeSet>

    <!-- =========================== SECTOR ================================== -->

    <changeSet id="20260816-23" author="Lucas Silva">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="im_sector"/>
            </not>
        </preConditions>

        <createTable tableName="im_sector">
            <column name="id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
