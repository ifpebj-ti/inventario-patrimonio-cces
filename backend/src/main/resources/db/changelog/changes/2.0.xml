<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Associa cada inventário a um setor para filtros e gráficos consolidados. -->
    <changeSet id="20261013-02" author="inventarium">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="im_inventory" columnName="id_sector"/>
            </not>
        </preConditions>
        <addColumn tableName="im_inventory">
            <column name="id_sector" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="im_inventory" baseColumnNames="id_sector"
                                 referencedTableName="im_sector" referencedColumnNames="id"
                                 constraintName="fk_inventory_sector"/>
        <createIndex tableName="im_inventory" indexName="ix_inventory_sector">
            <column name="id_sector"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
