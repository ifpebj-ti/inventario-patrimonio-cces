# OCI authentication
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00"
private_key_path = "~/.oci/inventarium_api_key.pem"
region           = "sa-saopaulo-1"

# Target compartment
compartment_ocid = "ocid1.compartment.oc1..example"

# Network
vcn_cidr                          = "10.42.0.0/24"
app_public_subnet_cidr            = "10.42.0.0/26"
observability_private_subnet_cidr = "10.42.0.64/26"
terraform_state_bucket_name       = "inventarium-terraform-state"

# VM access
ssh_public_key = "ssh-ed25519 AAAA... usuario@maquina"

# Network access allowlists.
# Use /32 when allowing a single public IP.
allowed_ssh_cidrs = ["203.0.113.10/32"]

# O site e publico e o Let's Encrypt (HTTP-01) valida pela porta 80 a partir da internet:
# 80/443 precisam estar abertos para 0.0.0.0/0. Restringir aqui impede a emissao do certificado.
allowed_web_cidrs = ["0.0.0.0/0"]

# IPs que podem abrir a UI do Portainer e o Grafana (aplicado pelo Nginx). Nunca 0.0.0.0/0.
allowed_admin_cidrs = ["203.0.113.10/32"]

# E-mail de contato da conta Let's Encrypt (avisos de expiracao).
acme_email = "voce@exemplo.com"

# Backups do Postgres (Object Storage). Use manage_backup_iam = false se o usuario do Terraform nao
# puder criar dynamic groups/policies; nesse caso crie-os manualmente (veja o runbook).
# backup_bucket_name    = "inventarium-backups"
# backup_retention_days = 30
# manage_backup_iam     = true

# Load Balancer e WAF da OCI (ADR 0009). Os padroes servem; so mexa se precisar.
# lb_public_subnet_cidr = "10.42.0.128/27"  # subnet publica so do LB, dentro da VCN e sem sobrepor as outras
# lb_min_mbps           = 10                # banda minima (faixa gratuita, a confirmar no Cost Estimator)
# lb_max_mbps           = 10
# waf_mode              = "DETECTION"       # so registra; passe para "BLOCK" depois de revisar os logs do WAF
# manage_edge_iam       = false             # true cria a policy para a VM trocar o certificado do LB
#
# O listener HTTPS so nasce depois do primeiro certificado enviado ao LB (docs/wiki/Deploy-em-Producao-OCI.md,
# secao 4.15): rode push-lb-certificate.sh --bootstrap na VM e preencha os dois valores abaixo.
# lb_https_enabled              = true
# lb_bootstrap_certificate_name = "inventarium-AAAAMMDD-xxxxxxxx"
#
# Com o LB em producao (etapa 3) a VM deixa de aceitar 80/443 direto da internet: allowed_web_cidrs = []

# Compute
app_instance_shape      = "VM.Standard.E5.Flex"
app_instance_ocpus      = 1
app_instance_memory_gbs = 2

observability_instance_shape      = "VM.Standard.E5.Flex"
observability_instance_ocpus      = 2
observability_instance_memory_gbs = 8
