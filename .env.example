# Copie para .env e preencha. O .env é ignorado pelo git.

# Obrigatório: chave de assinatura do JWT da aplicação.
# Gere com: openssl rand -hex 32
SECURITY_TOKEN_SECRET=

# Login com Google — é o único jeito de entrar no sistema.
# Client id do tipo "Web application" no Google Cloud Console.
# Consumido pelos DOIS lados: o backend valida o claim "aud" com ele, e o
# frontend o recebe como build arg NEXT_PUBLIC_GOOGLE_CLIENT_ID. Como o Next
# inlina no bundle durante o build, trocar o valor exige
# `docker compose build inventarium-front` — só subir de novo não basta.
GOOGLE_OAUTH_CLIENT_ID=

# Domínios que podem criar conta nova via Google. Vazio libera qualquer um.
# Cada entrada casa com o domínio e seus subdomínios: ifpe.edu.br cobre
# @ifpe.edu.br, @discente.ifpe.edu.br e @docente.ifpe.edu.br.
GOOGLE_ALLOWED_DOMAINS=ifpe.edu.br

# Credenciais de e-mail (SMTP do Gmail).
SPRING_MAIL_USERNAME=inventariumclp@gmail.com
SPRING_MAIL_PASSWORD=
