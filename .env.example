# Obrigatório: chave de assinatura do JWT da aplicação.
# Gere com: openssl rand -hex 32
SECURITY_TOKEN_SECRET=

POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=inventory_management

# Configuração Spring Boot usada pelo container do backend.
# Para executar com Docker Compose, use o host `postgres`; localmente, use `localhost`.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/inventory_management
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=none

BACKEND_IMAGE=inventarium-back:local
FRONTEND_IMAGE=inventarium-front:local

GOOGLE_OAUTH_CLIENT_ID=

NEXT_PUBLIC_API_URL=http://localhost:8080

GOOGLE_ALLOWED_DOMAINS=ifpe.edu.br

# Conta de sistema (admin) que entra por usuário e senha, sem Google, com perfil ADMIN_ORGANIZATION.
# Senha vazia desliga o login por senha. Mínimo de 12 caracteres; trocar aqui e reiniciar o backend
# troca a senha da conta.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=

# Limite de tentativas do login por senha: 5 falhas do mesmo usuário em 15 min bloqueiam esse usuário
# por 15 min (429), no backend. Os limites têm default no application.properties (AUTH_LOGIN_*). O
# limite por IP é do Nginx (zona auth, só no /auth/login). Atrás do Nginx de produção use `native`
# em FORWARD_HEADERS_STRATEGY (o Nginx SOBRESCREVE o X-Forwarded-For); sem proxy confiável deixe
# `none`. O limitador de login não depende dessa variável.
FORWARD_HEADERS_STRATEGY=none
# AUTH_LOGIN_USER_MAX_FAILURES=5
# AUTH_LOGIN_WINDOW=15m
# AUTH_LOGIN_BLOCK_DURATION=15m

SPRING_MAIL_USERNAME=inventariumclp@gmail.com
SPRING_MAIL_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Somente produção (docker-compose.production.yml, stack do Portainer na VM da OCI).
# Estas variáveis NÃO são lidas pelo docker-compose.yml de desenvolvimento.
# Em produção POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB, SPRING_MAIL_*, SECURITY_TOKEN_SECRET e
# GOOGLE_OAUTH_CLIENT_ID são obrigatórios e sem valor padrão; use segredos novos, nunca os de dev.
# ---------------------------------------------------------------------------------------------
# Tag das imagens do GHCR: `latest` segue a última release; para rollback use `vX.Y.Z`.
# IMAGE_TAG=latest
# Origens que o navegador pode usar para chamar a API (CORS), separadas por vírgula.
# Em desenvolvimento o padrão é http://localhost:3000; "*" é recusado pelo backend.
# CORS_ALLOWED_ORIGINS=https://inventariumifpe.me
# Em produção o Nginx sobrescreve o X-Forwarded-For; o compose de produção usa `native` por padrão.
# FORWARD_HEADERS_STRATEGY=native
