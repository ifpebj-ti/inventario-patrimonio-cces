# Obrigatório: chave de assinatura do JWT da aplicação.
# Gere com: openssl rand -hex 32
SECURITY_TOKEN_SECRET=

POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=3000

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=inventory_management

# Configuração Spring Boot usada pelo container do backend.
# Para executar com Docker Compose, use o host `postgres`; localmente, use `localhost`.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/inventory_management
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=none

BACKEND_IMAGE=inventarium-back:local
FRONTEND_IMAGE=inventarium-front:local

GOOGLE_OAUTH_CLIENT_ID=

NEXT_PUBLIC_API_URL=http://localhost:8080

GOOGLE_ALLOWED_DOMAINS=ifpe.edu.br

SPRING_MAIL_USERNAME=inventariumclp@gmail.com
SPRING_MAIL_PASSWORD=
